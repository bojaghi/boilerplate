{
  "name": "bojaghi/boilerplate",
  "description": "Bojaghi boilerplate",
  "homepage": "https://github.com/bojaghi/boilerplate",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
    }
  },
  "autoload-dev": {
    "psr-4": {
    }
  },
  "authors": [
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "bojaghi/dictionary": "^1.0",
    "wp-coding-standards/wpcs": "^3.0",
    "yoast/phpunit-polyfills": "^3.0",
    "alleyinteractive/composer-wordpress-autoloader": "^1.3"
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf"
  },
  "version": "1.0.0",
  "config": {
    "allow-plugins": {
      "alleyinteractive/composer-wordpress-autoloader": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "wordpress-autoloader": {
      "autoload": {
        "Bojaghi\\Boilerplace\\": "inc/"
      },
      "autoload-dev": {
        "Bojaghi\\Boilerplace\\": "tests/"
      },
      "inject": true
    }
  }
}
